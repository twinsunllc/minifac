{
  "name": "minifac",
  "version": "0.1.0",
  "description": "A miniature factory: directed (possibly cyclic) YAML graphs of agent + tool nodes, executed by a small TypeScript runner.",
  "keywords": [
    "agent",
    "workflow",
    "graph",
    "claude",
    "ai",
    "factory",
    "spec-driven-development",
    "openspec",
    "cli"
  ],
  "homepage": "https://github.com/twinsunllc/minifac#readme",
  "bugs": {
    "url": "https://github.com/twinsunllc/minifac/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twinsunllc/minifac.git"
  },
  "license": "MIT",
  "author": "Jami Couch",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "minifac": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-web-assets.mjs",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:dep-freshness": "node scripts/check-dep-freshness.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@types/react": "^19.2.14",
    "commander": "^12.1.0",
    "ink": "^7.0.3",
    "react": "^19.2.6",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7"
  }
}
