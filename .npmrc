# Reject any package version published less than 3 days ago.
# Supply-chain hygiene — see docs/decisions/0024-CI-Security-Policy.md.
# This gate applies to `npm install` and `npm update` (resolver picks
# an older version that meets the age threshold). The lockfile gate
# in CI (scripts/check-dep-freshness.mjs) catches committed lockfiles
# that contain freshly-published versions.
min-release-age=3
